{
  "generators": {
    "@nx/angular:application": {
      "style": "scss",
      "linter": "eslint",
      "unitTestRunner": "jest",
      "e2eTestRunner": "cypress"
    },
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "jest"
    },
    "@nx/angular:component": {
      "style": "scss",
      "type": "component"
    },
    "@schematics/angular:component": {
      "type": "component"
    },
    "@nx/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@nx/angular:service": {
      "type": "service"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@nx/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@nx/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@nx/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@nx/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@nx/angular:resolver": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "e2e": [
      {
        "inputs": ["default", "^production"],
        "cache": true
      },
      {
        "filter": {
          "plugin": "@nx/cypress/plugin"
        },
        "options": {
          "config-file": "./cypress.config.ts"
        }
      }
    ],
    "@nx/angular:package": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "test": [
      {
        "filter": {
          "plugin": "@nx/jest/plugin"
        },
        "configurations": {
          "ci": {
            "ci": true,
            "coverage": true
          }
        },
        "options": {
          "passWithNoTests": true
        }
      }
    ]
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": ["{workspaceRoot}/azure-pipelines.yml"],
    "production": [
      "default",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/src/test-setup.[jt]s"
    ]
  },
  "useInferencePlugins": false,
  "defaultBase": "master",
  "nxCloudId": "62359f15bf0c8571ede4a0e2",
  "release": {
    "version": {
      "preVersionCommand": "npx nx run-many -t build"
    }
  },
  "analytics": true,
  "plugins": [
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      },
      "include": [
        "apps/adventure-works/**/*",
        "apps/imng-inventory/**/*",
        "apps/nurse-cron/**/*",
        "libs/imng-angular-core/**/*",
        "libs/imng-application-insights-ngrx/**/*",
        "libs/imng-kendo-chart-odata/**/*",
        "libs/imng-kendo-data-entry/**/*",
        "libs/imng-kendo-grid/**/*",
        "libs/imng-kendo-grid-array/**/*",
        "libs/imng-kendo-grid-editable/**/*",
        "libs/imng-kendo-grid-filtering/**/*",
        "libs/imng-kendo-grid-odata/**/*",
        "libs/imng-kendo-ngrx-idle/**/*",
        "libs/imng-kendo-odata/**/*",
        "libs/imng-kendo-testing-stubs/**/*",
        "libs/imng-ngrx-utils/**/*",
        "libs/imng-nrsrx-client-utils/**/*",
        "libs/imng-odata-client/**/*",
        "libs/imng-oidc-client/**/*",
        "libs/imng-prime-table-odata/**/*",
        "libs/imng-signalr-ngrx/**/*",
        "libs/imng-snippets/**/*"
      ]
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "include": [
        "apps/adventure-works/**/*",
        "apps/adventure-works-e2e/**/*",
        "apps/imng-inventory/**/*",
        "apps/imng-inventory-e2e/**/*",
        "apps/nurse-cron/**/*",
        "apps/nurse-cron-e2e/**/*",
        "libs/imng-angular-core/**/*",
        "libs/imng-application-insights-ngrx/**/*",
        "libs/imng-kendo-chart-odata/**/*",
        "libs/imng-kendo-data-entry/**/*",
        "libs/imng-kendo-grid/**/*",
        "libs/imng-kendo-grid-array/**/*",
        "libs/imng-kendo-grid-editable/**/*",
        "libs/imng-kendo-grid-filtering/**/*",
        "libs/imng-kendo-grid-odata/**/*",
        "libs/imng-kendo-ngrx-idle/**/*",
        "libs/imng-kendo-odata/**/*",
        "libs/imng-kendo-testing-stubs/**/*",
        "libs/imng-ngrx-utils/**/*",
        "libs/imng-nrsrx-client-utils/**/*",
        "libs/imng-odata-client/**/*",
        "libs/imng-oidc-client/**/*",
        "libs/imng-prime-table-odata/**/*",
        "libs/imng-signalr-ngrx/**/*",
        "libs/imng-snippets/**/*"
      ]
    },
    {
      "plugin": "@nx/cypress/plugin",
      "options": {
        "targetName": "e2e",
        "ciTargetName": "e2e-ci",
        "componentTestingTargetName": "component-test",
        "openTargetName": "open-cypress"
      }
    }
  ],
  "affected": {
    "legacy": true
  }
}
